{
  "name": "@ancher-ai/sdk",
  "version": "0.2.0",
  "description": "Fully-typed TypeScript SDK for the Ancher API, generated from the OpenAPI spec.",
  "license": "Apache-2.0",
  "homepage": "https://ancher.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamify-one/ancher-sdk-typescript.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./oauth2": "./src/presets/oauth2.ts",
    "./tanstack": "./src/tanstack.ts",
    "./contracts": "./src/contracts/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./oauth2": {
        "import": {
          "types": "./dist/oauth2.d.ts",
          "default": "./dist/oauth2.js"
        },
        "require": {
          "types": "./dist/oauth2.d.cts",
          "default": "./dist/oauth2.cjs"
        }
      },
      "./tanstack": {
        "import": {
          "types": "./dist/tanstack.d.ts",
          "default": "./dist/tanstack.js"
        },
        "require": {
          "types": "./dist/tanstack.d.cts",
          "default": "./dist/tanstack.cjs"
        }
      },
      "./contracts": {
        "import": {
          "types": "./dist/contracts.d.ts",
          "default": "./dist/contracts.js"
        },
        "require": {
          "types": "./dist/contracts.d.cts",
          "default": "./dist/contracts.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "generate": "node scripts/fetch-openapi.js && typed-openapi openapi.json --output src/api/generated/api.client.ts --tanstack",
    "dev": "tsup --watch",
    "build": "tsup && node scripts/fix-tanstack-declarations.mjs",
    "verify:package": "pnpm build && node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "tsup": "^8.3.0",
    "typed-openapi": "^2.2.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
