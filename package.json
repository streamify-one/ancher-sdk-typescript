{
  "name": "@ancher-ai/sdk",
  "version": "0.1.0",
  "description": "Fully-typed TypeScript SDK for the Ancher API, generated from the OpenAPI spec.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/presets/browser.ts",
    "./oauth2": "./src/presets/oauth2.ts",
    "./session": "./src/presets/session.ts",
    "./tanstack": "./src/tanstack.ts",
    "./contracts": "./src/contracts/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js",
        "require": "./dist/browser.cjs"
      },
      "./oauth2": {
        "types": "./dist/oauth2.d.ts",
        "import": "./dist/oauth2.js",
        "require": "./dist/oauth2.cjs"
      },
      "./session": {
        "types": "./dist/session.d.ts",
        "import": "./dist/session.js",
        "require": "./dist/session.cjs"
      },
      "./tanstack": {
        "types": "./dist/tanstack.d.ts",
        "import": "./dist/tanstack.js",
        "require": "./dist/tanstack.cjs"
      },
      "./contracts": {
        "types": "./dist/contracts.d.ts",
        "import": "./dist/contracts.js",
        "require": "./dist/contracts.cjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "generate": "node scripts/fetch-openapi.js && typed-openapi openapi.json --output src/api/generated/api.client.ts --tanstack",
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "tsup": "^8.3.0",
    "typed-openapi": "^2.2.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
